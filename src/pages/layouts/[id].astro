---
import Base from '../../layouts/Base.astro';
import Keyboard from '../../components/Keyboard.astro';
import TypingPlayer from '../../components/TypingPlayer.astro';
import Heatmap from '../../components/Heatmap.astro';
import { LAYOUTS, genreOf, neighbours, scaleLabels, attribution, respondentNote } from '../../lib/data.js';

export function getStaticPaths() {
  return LAYOUTS.map(l => ({ params: { id: l.id }, props: { layout: l } }));
}

const { layout: l } = Astro.props;
const g = genreOf(l.genre);
const { prev, next } = neighbours(l);
const says = attribution(l);
const crumb = `<a href="/">カタログ</a> ／ <a href="/#${g.id}">${g.name}</a> ／ ${l.name}`;

const scale = (labels, i) => labels.map((t, j) => ({ t, on: j === i }));
---
<Base title={`${l.name}｜新配列カタログ`} description={l.q31} crumb={crumb}>
  <main class="wrap" style={`--gc:${g.color}`}>
    <header class="head">
      <div class="genre">{g.name}</div>
      <h1 class="mincho">{l.name}</h1>
      <div class="kana">{l.kana}</div>
      <div class="meta">
        {l.author && <span>作者　<b>{l.author}</b></span>}
        {l.year && <span>公開　<b>{l.year}年</b></span>}
        {l.version && <span>現行版　<b>{l.version}</b></span>}
      </div>
    </header>

    <div class="cols">
      <div>
        {(l.keymapRows || l.figure) && (
          <figure class="fig">
            {l.keymapRows
              ? <Keyboard rows={l.keymapRows} subRows={l.keymapSubRows} geometry={l.geometry}
                          color={g.color} label={`${l.name}の配列図`} />
              : <img src={`/figures/${l.figure}`} alt={`${l.name}の配列図`} />}
            <figcaption>
              配列図{l.figure ? '（作者ご提出）' : ''}
              {l.keyboard && `　${l.keyboard}を想定しています。`}
              {l.keymapSubRows && '　キーの下段が単打、上段の小さい文字がシフト同時押しです。'}
            </figcaption>
          </figure>
        )}

        <p class="lead mincho">{l.q31}</p>
        {l.q32 && <p class="supp">{l.q32}</p>}

        {l.anim && <Heatmap id={l.anim} geometry={l.geometry} />}

        {l.anim && <TypingPlayer ids={[l.anim, 'qwerty']} geometries={[l.geometry, 'row']} />}

        <section>
          <h2 class="mincho">タイピングの特徴</h2>
          <div class="src">{says}</div>
          {l.q11 && <div class="qa"><h3>キーの連なり</h3><p>{l.q11}</p></div>}
          {l.q12 && <div class="qa"><h3>長文を打ったときの疲れにくさ</h3><p>{l.q12}</p></div>}
          {l.aimIndex !== null && (
            <div class="qa"><h3>設計で重視したこと</h3>
              <div class="scale">{scale(scaleLabels.aim, l.aimIndex).map(x =>
                <div class={x.on ? 'on' : ''}>{x.t}</div>)}</div>
            </div>
          )}
        </section>

        <section>
          <h2 class="mincho">覚えやすさ</h2>
          <div class="src">{says}習得にかかる時間は、他配列の平均との比較としてご回答いただいています。</div>
          {l.learnIndex !== null && (
            <div class="qa"><h3>習得にかかる時間</h3>
              <div class="scale">{scale(scaleLabels.learn, l.learnIndex).map(x =>
                <div class={x.on ? 'on' : ''}>{x.t}</div>)}</div>
              {l.q21c && <p class="mt">{l.q21c}</p>}
            </div>
          )}
          {l.q23 && <div class="qa"><h3>覚えやすくするための工夫</h3><p>{l.q23}</p></div>}
          {l.q22 && <div class="qa"><h3>日本語の入力に必要なキー数</h3><p>{l.q22}</p></div>}
        </section>

        <section class="warn">
          <h2 class="mincho">不得意なこと・向いていない人</h2>
          <div class="src">{says}</div>
          {l.q4 ? <p>{l.q4}</p> : <p class="none">ご回答はありません。</p>}
        </section>

        <div class="foot">{respondentNote(l)}{l.updated && `　最終更新　${l.updated}`}</div>
      </div>

      <aside class="side">
        <div class="box">
          <h2>方式</h2>
          <dl>
            <dt>ジャンル</dt><dd>{g.name}</dd>
            {l.shift && <><dt>シフト方式</dt><dd>{l.shift}</dd></>}
            {l.chord && <><dt>同時打鍵</dt><dd>{l.chord}</dd></>}
          </dl>
        </div>
        <div class="box">
          <h2>動作環境</h2>
          <dl>
            {l.os && <><dt>対応OS</dt><dd>{l.os}</dd></>}
            {l.software && <><dt>必要ソフト・ファームウェア</dt><dd>{l.software}</dd></>}
            {l.phys_keys && <><dt>必要キー数</dt><dd>{l.phys_keys}</dd></>}
            {l.thumb && <><dt>親指キー</dt><dd>{l.thumb}</dd></>}
            {l.keyboard && <><dt>想定キーボード</dt><dd>{l.keyboard}</dd></>}
          </dl>
        </div>
        {l.resourceList.length > 0 && (
          <div class="box">
            <h2>練習用の教材</h2>
            <ul>{l.resourceList.map(r => <li><a href={r.href}>{r.title}</a></li>)}</ul>
          </div>
        )}
        {l.url && <div class="box"><a class="go" href={l.url}>公式サイト（配布・解説）</a></div>}
      </aside>
    </div>

    <nav class="pager">
      {prev ? <a href={`/layouts/${prev.id}/`}>← {prev.name}</a> : <span />}
      <a href={`/#${g.id}`}>{g.name}の一覧に戻る</a>
      {next ? <a href={`/layouts/${next.id}/`}>{next.name} →</a> : <span />}
    </nav>
  </main>
</Base>

<style>
.head{border-top:4px solid var(--gc);padding-top:20px;margin:28px 0;}
.head .genre{font-size:12.5px;color:var(--gc);font-weight:700;letter-spacing:.08em}
.head h1{font-size:40px;font-weight:700;letter-spacing:.05em;line-height:1.25;margin-top:4px}
.head .kana{font-size:12.5px;color:var(--ink-soft);letter-spacing:.1em;margin-top:4px}
.head .meta{margin-top:14px;font-size:13px;color:var(--ink-soft);
  display:flex;flex-wrap:wrap;gap:4px 20px}
.head .meta b{font-weight:400;color:var(--ink)}

.cols{display:grid;grid-template-columns:minmax(0,1fr) 296px;gap:44px;align-items:start}
.fig{background:#fff;border:1px solid var(--rule);padding:20px 22px 14px;margin-bottom:32px}
.fig figcaption{font-size:12px;color:var(--ink-soft);margin-top:10px;
  border-top:1px solid var(--paper-2);padding-top:9px}
.lead{font-size:21px;line-height:1.8;font-weight:500;margin-bottom:16px}
.supp{font-size:15px;margin-bottom:40px}

section{margin-bottom:40px}
section > h2{font-size:20px;font-weight:700;letter-spacing:.05em;
  border-bottom:2px solid var(--ink);padding-bottom:7px;margin-bottom:6px}
section > .src{font-size:11.5px;color:var(--ink-soft);margin-bottom:18px}
.qa{margin-bottom:22px}
.qa h3{font-size:13px;color:var(--ink-soft);font-weight:400;margin-bottom:1px}
.qa p{font-size:16px;line-height:1.8}
.qa .mt{margin-top:8px}
.none{color:var(--ink-soft);font-size:14px}

.warn{border:1px solid var(--rule-strong);border-left:4px solid #7A5C2E;background:#fff;padding:16px 20px}
.warn h2{font-size:18px;font-weight:700;margin-bottom:4px;border:0;padding:0}
.warn .src{font-size:11.5px;color:var(--ink-soft);margin-bottom:10px}
.warn p{font-size:15px}

.side{position:sticky;top:20px;display:grid;gap:20px}
.box{background:#fff;border:1px solid var(--rule)}
.box h2{font-size:12.5px;font-weight:700;color:var(--ink-soft);padding:12px 16px 0;letter-spacing:.06em}
.box dl{padding:8px 16px 14px;font-size:13.5px}
.box dt{color:var(--ink-soft);font-size:12px;margin-top:9px}
.box dd{line-height:1.65}
.box dt:first-of-type{margin-top:2px}
.box ul{list-style:none;padding:10px 16px 14px;font-size:13.5px}
.box li{padding:5px 0;border-bottom:1px solid var(--paper-2)}
.box li:last-child{border-bottom:0}
.box .go{display:block;padding:11px 16px;background:var(--gc);color:#fff;
  text-decoration:none;text-align:center;font-size:14px}
.box .go:hover{filter:brightness(.88)}

.foot{border-top:1px solid var(--rule);margin-top:8px;padding:20px 0 8px;
  font-size:12.5px;color:var(--ink-soft)}
.pager{display:flex;justify-content:space-between;gap:16px;
  border-top:1px solid var(--rule);padding:18px 0 0;font-size:13.5px}
.pager a{text-decoration:none}
.pager a:hover{text-decoration:underline}

@media (max-width:860px){
  .cols{grid-template-columns:1fr;gap:32px}
  .side{position:static}
  .head h1{font-size:31px}
}
</style>
