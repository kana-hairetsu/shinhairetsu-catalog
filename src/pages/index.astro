---
import Base from '../layouts/Base.astro';
import LayoutCard from '../components/LayoutCard.astro';
import { byGenre, LAYOUTS } from '../lib/data.js';

const sections = byGenre().filter(g => g.layouts.length > 0);
const asOf = '2026年10月1日';
---
<Base title="新配列カタログ" description="日本語をもっと快適に入力しよう！脱QWERTYを考え始めた人のための、新しい入力方法（論理配列）を集めたカタログです。">
  <main class="wrap">
    <header class="hero">
      <img class="hero-logo" src="/logo-keycaps.png" width="880" height="450"
        alt="「A」と「あ」のキーキャップ" />
      <h1 class="head-font">新配列カタログ</h1>
      <p class="catch head-font">日本語をもっと快適に入力しよう！</p>
      <p class="lede">脱QWERTYを考え始めた人のための<br />新しい入力方法（論理配列）を集めたカタログです</p>
      <a class="cta" href="#genres">配列を見てみる</a>
      <p class="asof">{asOf}現在　全{LAYOUTS.length}配列を掲載</p>
    </header>

    <nav class="index" id="genres" aria-label="ジャンル">
      <h2>ジャンルから探す</h2>
      <ol>
        {sections.map(g => (
          <li>
            <a href={`#${g.id}`} style={`--gc:${g.color}`}>
              <span class="g">{g.name}</span>
              <span class="c">{g.layouts.length}配列</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {sections.map(g => (
      <section class="genre" id={g.id} style={`--gc:${g.color}`}>
        <div class="genre-h">
          <div>
            <h2 class="head-font">{g.name}</h2>
            <div class="c">{g.layouts.length}配列</div>
          </div>
          <p>{g.desc}</p>
        </div>
        <div class="cards">
          {g.layouts.map(l => <LayoutCard layout={l} color={g.color} />)}
        </div>
      </section>
    ))}

    <section class="apply" id="apply" aria-labelledby="apply-h">
      <div>
        <h2 id="apply-h">掲載の申し込み</h2>
        <p>配列の作者さまは、Xの @kanahairetsu へ、メンションかDMでご連絡ください。</p>
      </div>
      <a class="apply-btn" href="https://x.com/kanahairetsu" rel="me">Xで @kanahairetsu に連絡する</a>
    </section>
  </main>
</Base>

<style>
.hero{margin:48px 0 56px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px}
.hero-logo{width:min(440px,86%)}
.hero h1{font-size:48px;font-weight:900;letter-spacing:.06em;line-height:1.25}
.catch{font-size:23px;font-weight:700;line-height:1.5;margin-top:-6px}
.lede{font-size:15.5px;color:var(--ink-soft);line-height:1.9}
.cta{display:inline-flex;align-items:center;min-height:48px;padding:0 28px;border-radius:8px;
  background:var(--ink);color:var(--paper);font-weight:700;text-decoration:none}
.cta:hover{background:#000}
.asof{font-size:12.5px;color:var(--ink-soft);margin-top:-8px}

.index{margin-bottom:64px;scroll-margin-top:24px}
.index h2{font-size:13px;color:var(--ink-soft);font-weight:400;margin-bottom:12px}
.index ol{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}
.index a{display:flex;flex-direction:column;gap:2px;height:100%;padding:16px 18px;text-decoration:none;
  background:#fff;border:1px solid var(--rule);border-left:4px solid var(--gc);border-radius:10px}
.index a:hover{border-color:var(--gc)}
.index .g{font-family:"Zen Kaku Gothic New","BIZ UDPGothic",sans-serif;font-size:17px;font-weight:700}
.index .c{font-size:12.5px;color:var(--ink-soft)}

.genre{margin-bottom:64px;scroll-margin-top:24px}
.genre-h{border-top:3px solid var(--gc);padding-top:16px;margin-bottom:24px;
  display:grid;grid-template-columns:minmax(0,240px) minmax(0,1fr);gap:12px 40px;align-items:start}
.genre-h h2{font-size:25px;font-weight:700;letter-spacing:.04em;color:var(--gc)}
.genre-h .c{font-size:12.5px;color:var(--ink-soft);margin-top:2px}
.genre-h p{font-size:14px;max-width:56ch}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:22px}

.apply{border-top:1px solid var(--rule);padding-top:32px;scroll-margin-top:24px;
  display:flex;flex-wrap:wrap;gap:16px 32px;align-items:center;justify-content:space-between}
.apply h2{font-size:17px;font-weight:700}
.apply p{font-size:14px;color:var(--ink-soft)}
.apply-btn{display:inline-flex;align-items:center;min-height:48px;padding:0 24px;border-radius:8px;
  border:1.5px solid var(--ink);text-decoration:none;font-weight:700}
.apply-btn:hover{background:#fff}

@media (max-width:760px){
  .genre-h{grid-template-columns:1fr;gap:8px}
  .hero{margin:32px 0 44px;gap:18px}
  .hero h1{font-size:32px}
  .catch{font-size:19px}
  .lede{font-size:14.5px}
  .index ol{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .index a{padding:12px 14px}
}
</style>
