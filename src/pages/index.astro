---
import Base from '../layouts/Base.astro';
import LayoutCard from '../components/LayoutCard.astro';
import { byGenre, LAYOUTS } from '../lib/data.js';

const sections = byGenre().filter(g => g.layouts.length > 0);
const asOf = '2026年10月1日';
---
<Base title="新配列カタログ">
  <main class="wrap">
    <header class="site-head">
      <h1 class="mincho">新配列カタログ</h1>
      <p class="lede">日本語をより快適に打つための配列を集めました。ジャンル別に掲載しています。</p>
      <p class="asof">{asOf}現在　全{LAYOUTS.length}配列を掲載</p>
    </header>

    <nav class="index" aria-label="ジャンル">
      <h2>ジャンルから探す</h2>
      <ol>
        {sections.map(g => (
          <li>
            <a href={`#${g.id}`} style={`--gc:${g.color}`}>
              <span class="g">{g.name}</span>
              <span class="c">{g.layouts.length}配列</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {sections.map(g => (
      <section class="genre" id={g.id} style={`--gc:${g.color}`}>
        <div class="genre-h">
          <div>
            <h2 class="mincho">{g.name}</h2>
            <div class="c">{g.layouts.length}配列</div>
          </div>
          <p>{g.desc}</p>
        </div>
        <div class="cards">
          {g.layouts.map(l => <LayoutCard layout={l} color={g.color} />)}
        </div>
      </section>
    ))}
  </main>
</Base>

<style>
.site-head{margin:36px 0 26px;padding-bottom:22px;border-bottom:2px solid var(--ink)}
.site-head h1{font-size:31px;font-weight:700;letter-spacing:.06em;line-height:1.3}
.lede{margin-top:10px;font-size:14.5px;color:var(--ink-soft);max-width:52ch}
.asof{margin-top:12px;font-size:12.5px;color:var(--ink-soft)}

.index{margin-bottom:56px}
.index h2{font-size:13px;color:var(--ink-soft);font-weight:400;margin-bottom:12px}
.index ol{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));
  border-top:1px solid var(--rule)}
.index a{display:block;padding:12px 14px 13px;text-decoration:none;
  border-bottom:1px solid var(--rule);border-left:4px solid var(--gc)}
.index a:hover{background:#fff}
.index .g{font-family:"Shippori Mincho B1",serif;font-size:16.5px;font-weight:700;display:block}
.index .c{font-size:12px;color:var(--ink-soft)}

.genre{margin-bottom:64px;scroll-margin-top:24px}
.genre-h{border-top:3px solid var(--gc);padding-top:16px;margin-bottom:24px;
  display:grid;grid-template-columns:minmax(0,240px) minmax(0,1fr);gap:12px 40px;align-items:start}
.genre-h h2{font-size:25px;font-weight:700;letter-spacing:.04em;color:var(--gc)}
.genre-h .c{font-size:12.5px;color:var(--ink-soft);margin-top:2px}
.genre-h p{font-size:14px;max-width:56ch}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:22px}

@media (max-width:760px){
  .genre-h{grid-template-columns:1fr;gap:8px}
  .site-head h1{font-size:25px}
}
</style>
