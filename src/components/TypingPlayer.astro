---
/**
 * タイピング動画。public/anim/<id>.json を読み込んで再生する。
 * ids には比較したい配列を並べる（先頭が主役、通常は基準として qwerty を添える）。
 */
import HEAT from '../data/heat.json';
import { boardFromLabels } from '../lib/keyboard.js';

const { ids = [], geometries = [], title = 'タイピングのようす' } = Astro.props;
const uid = 'tp' + Math.random().toString(36).slice(2, 8);

/* 盤面はここで組み立てて渡す。配列図・ヒートマップと同じ関数を使うので並びが揃う */
const boards = ids.map((id, i) => {
  const h = HEAT[id];
  return h ? boardFromLabels(h.labels, h.subs, geometries[i] ?? 'row', Object.keys(h.heat)) : [];
});
---
<section class="player" id={uid}>
  <h2 class="mincho">{title}</h2>
  <p class="src">
    夏目漱石『吾輩は猫である』の冒頭を打ったときの動きです。<b>どの配列も同じ時刻に打ち終わります</b>。
    1打あたりの間隔は「再生時間 ÷ アクション数」で決まるため、アクションの多い配列ほど速く刻みます。
    同時押しは1回の動作として数え、押されたキーを臙脂色で表示します。
  </p>

  <div class="bar">
    <button data-role="play">再生</button>
    <button class="ghost" data-role="reset">最初から</button>
    <span class="set"><span class="lbl">再生時間</span>
      <button class="ghost dur" data-s="90">90秒</button>
      <button class="ghost dur on" data-s="180">180秒</button>
      <button class="ghost dur" data-s="360">360秒</button>
    </span>
    <span class="set"><span class="lbl">速さ</span>
      <button class="ghost spd" data-x="0.5">×0.5</button>
      <button class="ghost spd on" data-x="1">×1</button>
      <button class="ghost spd" data-x="2">×2</button>
    </span>
    <span class="eff">実際の長さ <b data-role="eff">180</b> 秒</span>
    <span class="legend">
      <span><i style="background:var(--gc)"></i>単打</span>
      <span><i style="background:var(--chord)"></i>同時押し／裏レイヤーの印字</span>
    </span>
  </div>

  <div class="grid" data-role="grid"></div>
  <div class="ticker" data-role="ticker"></div>
</section>

<script define:vars={{ uid, ids, boards }}>
(async () => {
  const root = document.getElementById(uid);
  const U = 29.4, KW = 27, KH = 27, CHORD = '#8E3B46';
  const fmt = n => n.toLocaleString('ja-JP');
  const $ = r => root.querySelector(`[data-role="${r}"]`);

  let files;
  try {
    files = await Promise.all(ids.map(id =>
      fetch(`/anim/${id}.json`).then(r => { if (!r.ok) throw new Error(id); return r.json(); })));
  } catch (e) {
    root.querySelector('.grid').innerHTML =
      '<p class="err">動画データを読み込めませんでした。</p>';
    return;
  }

  const META = files[0];
  const LAY = files.map((f, i) => ({ ...f.layout, keys: boards[i] }));
  let base = 180000, speed = 1, DUR = 180000;
  let t0 = null, raf = null, running = false, pausedAt = 0, lastEl = 0, lastCi = -1;

  const board = (L, gi) => {
    const w = Math.max(...L.keys.map(k => k.x + k.w)) * U + 2;
    const h = (Math.max(...L.keys.map(k => k.y)) + 1) * U + 2;
    let s = `<svg viewBox="0 0 ${w.toFixed(1)} ${h.toFixed(1)}" xmlns="http://www.w3.org/2000/svg">`;
    L.keys.forEach(k => {
      const x = 1 + k.x * U, y = 1 + k.y * U, kw = k.w * U - (U - KW), cx = (x + kw / 2).toFixed(1);
      s += `<rect id="${uid}-${gi}-${k.id}" x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${kw.toFixed(1)}"
             height="${KH}" rx="2.5" fill="#fff" stroke="${k.dim ? '#C8C7BF' : '#B4B3AB'}"/>`;
      if (k.s) {
        s += `<text x="${cx}" y="${(y + 11).toFixed(1)}" font-size="9.5" text-anchor="middle"
               font-family="serif" fill="${CHORD}" opacity=".85">${k.s}</text>`;
        if (k.l) s += `<text x="${cx}" y="${(y + 23).toFixed(1)}" font-size="12" text-anchor="middle"
               font-family="serif" fill="${L.color}">${k.l}</text>`;
      } else if (k.l) {
        s += `<text x="${cx}" y="${(y + KH / 2 + 4.4).toFixed(1)}" font-size="${k.l.length > 1 ? 11 : 12.5}"
               text-anchor="middle" font-family="serif" fill="${k.dim ? '#A5A49C' : L.color}">${k.l}</text>`;
      }
    });
    return s + '</svg>';
  };

  $('grid').innerHTML = LAY.map((L, i) => `
    <section class="panel" style="--gc:${L.color}">
      <h3>${L.name}</h3><div class="g">${L.genre}</div>
      <div class="kbd">${board(L, i)}</div>
      <div class="prog"><i id="${uid}-p${i}"></i></div>
      <div class="cap">お題文 ${fmt(META.clip_chars)}字（全${fmt(L.clip.actions)}アクション）／ 1打 <span id="${uid}-ms${i}">—</span></div>
      <div class="nums">
        <div><span>打鍵数</span><b id="${uid}-n${i}k">0</b></div>
        <div><span>同時押し</span><b id="${uid}-n${i}c">0</b></div>
        <div><span>アクション</span><b id="${uid}-n${i}a">0</b></div>
      </div>
      <div class="total">お題文 全${fmt(META.full_chars)}字では　打鍵 <b>${fmt(L.full.keys)}</b>　同時押し <b>${fmt(L.full.chords)}</b>　アクション <b>${fmt(L.full.actions)}</b></div>
    </section>`).join('');

  const KEYMAP = LAY.map(L => Object.fromEntries(L.keys.map(k => [k.id, k])));
  const lit = LAY.map(() => []);
  const clear = i => {
    lit[i].forEach(k => {
      const e = document.getElementById(`${uid}-${i}-${k.id}`);
      if (e) { e.setAttribute('fill', '#fff'); e.setAttribute('stroke', k.dim ? '#C8C7BF' : '#B4B3AB'); }
    });
    lit[i] = [];
  };

  const applyTiming = () => {
    DUR = base / speed;
    $('eff').textContent = (DUR / 1000).toFixed(DUR % 1000 ? 1 : 0);
    LAY.forEach((L, i) => {
      document.getElementById(`${uid}-ms${i}`).textContent =
        Math.round(DUR / L.actions.length) + ' ミリ秒';
    });
  };

  function frame(ts) {
    if (t0 === null) t0 = ts - pausedAt;
    const el = Math.min(ts - t0, DUR); lastEl = el;
    const p = el / DUR;
    let ci = 0;
    LAY.forEach((L, i) => {
      const n = L.actions.length, idx = Math.min(Math.floor(p * n), n - 1), a = L.actions[idx];
      clear(i);
      const col = a.k.length > 1 ? CHORD : L.color;
      a.k.forEach(id => {
        const k = KEYMAP[i][id]; if (!k) return;
        const e = document.getElementById(`${uid}-${i}-${id}`);
        if (e) { e.setAttribute('fill', col); e.setAttribute('stroke', col); lit[i].push(k); }
      });
      let keys = 0, ch = 0;
      for (let j = 0; j <= idx; j++) { keys += L.actions[j].k.length; if (L.actions[j].k.length > 1) ch++; }
      document.getElementById(`${uid}-n${i}k`).textContent = fmt(keys);
      document.getElementById(`${uid}-n${i}c`).textContent = fmt(ch);
      document.getElementById(`${uid}-n${i}a`).textContent = fmt(idx + 1);
      document.getElementById(`${uid}-p${i}`).style.width = (p * 100) + '%';
      if (i === 0) ci = a.c;
    });
    if (ci !== lastCi) {
      lastCi = ci;
      const T = META.text, box = $('ticker');
      box.innerHTML = `<span class="done">${T.slice(0, ci + 1)}</span><span class="cur"></span><span class="todo">${T.slice(ci + 1)}</span>`;
      const cur = box.querySelector('.cur');
      box.scrollTop = Math.max(0, cur.offsetTop - box.clientHeight * 0.55);
    }
    if (el < DUR && running) raf = requestAnimationFrame(frame);
    else if (el >= DUR) { running = false; pausedAt = 0; t0 = null; $('play').textContent = 'もう一度'; }
  }

  function reset() {
    cancelAnimationFrame(raf); running = false; t0 = null; pausedAt = 0; lastEl = 0; lastCi = -1;
    LAY.forEach((L, i) => {
      clear(i);
      ['k', 'c', 'a'].forEach(s => document.getElementById(`${uid}-n${i}${s}`).textContent = '0');
      document.getElementById(`${uid}-p${i}`).style.width = '0';
    });
    const box = $('ticker');
    box.innerHTML = `<span class="todo">${META.text}</span>`; box.scrollTop = 0;
    $('play').textContent = '再生';
  }

  applyTiming(); reset();

  $('play').addEventListener('click', () => {
    const b = $('play');
    if (running) { running = false; cancelAnimationFrame(raf); pausedAt = lastEl; t0 = null; b.textContent = '再開'; }
    else {
      if (b.textContent === 'もう一度') reset();
      running = true; b.textContent = '一時停止'; raf = requestAnimationFrame(frame);
    }
  });
  $('reset').addEventListener('click', reset);

  const retime = fn => {
    const ratio = DUR ? lastEl / DUR : 0;
    fn(); applyTiming();
    pausedAt = ratio * DUR; lastEl = pausedAt; t0 = null;
    if (!running) $('play').textContent = pausedAt > 0 ? '再開' : '再生';
  };
  root.querySelectorAll('.dur').forEach(b => b.addEventListener('click', () => {
    root.querySelectorAll('.dur').forEach(x => x.classList.remove('on')); b.classList.add('on');
    retime(() => { base = +b.dataset.s * 1000; });
  }));
  root.querySelectorAll('.spd').forEach(b => b.addEventListener('click', () => {
    root.querySelectorAll('.spd').forEach(x => x.classList.remove('on')); b.classList.add('on');
    retime(() => { speed = +b.dataset.x; });
  }));
})();
</script>

<style>
.player{margin-bottom:44px}
.player > h2{font-size:20px;font-weight:700;letter-spacing:.05em;
  border-bottom:2px solid var(--ink);padding-bottom:7px;margin-bottom:6px}
.player .src{font-size:11.5px;color:var(--ink-soft);margin-bottom:16px;line-height:1.7}
.player .src b{color:var(--ink)}
.bar{display:flex;flex-wrap:wrap;gap:10px 20px;align-items:center;
  border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);padding:12px 0;margin-bottom:20px}
.set{display:flex;align-items:center;gap:6px}
.lbl{font-size:12.5px;color:var(--ink-soft)}
.player button{appearance:none;font:inherit;font-size:14px;background:var(--gc);color:#fff;
  border:0;padding:8px 22px;border-radius:2px;cursor:pointer}
.player button.ghost{background:none;color:var(--ink-soft);border:1px solid var(--rule-strong);
  padding:6px 14px;font-size:13px}
.player button.ghost.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.player button:hover{filter:brightness(1.08)}
.player button:focus-visible{outline:2px solid var(--gc);outline-offset:2px}
.eff{font-size:12.5px;color:var(--ink-soft)}
.eff b{color:var(--ink);font-variant-numeric:tabular-nums}
.legend{display:flex;gap:14px;font-size:12px;color:var(--ink-soft);flex-wrap:wrap}
.legend i{display:inline-block;width:12px;height:12px;border-radius:2px;vertical-align:-2px;margin-right:5px}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px;margin-bottom:20px}
.panel{background:#fff;border:1px solid var(--rule);border-top:4px solid var(--gc);
  display:flex;flex-direction:column}
.panel h3{font-family:"Shippori Mincho B1",serif;font-size:19px;font-weight:700;padding:13px 16px 0}
.panel .g{font-size:11.5px;color:var(--gc);padding:0 16px 8px;letter-spacing:.06em}
.kbd{padding:0 12px 10px}
.kbd svg{display:block;width:100%;height:auto}
.prog{height:4px;background:var(--paper-2);margin:0 12px}
.prog i{display:block;height:100%;background:var(--gc);width:0}
.cap{font-size:11px;color:var(--ink-soft);padding:10px 16px 0}
.nums{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);
  border-top:1px solid var(--rule);margin-top:8px}
.nums div{background:#fff;padding:9px 11px}
.nums span{display:block;font-size:11px;color:var(--ink-soft)}
.nums b{font-size:18px;font-weight:700;font-variant-numeric:tabular-nums}
.total{padding:10px 16px;background:var(--paper-2);font-size:12px;color:var(--ink-soft);line-height:1.6}
.total b{color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums}
.ticker{background:#fff;border:1px solid var(--rule);padding:16px 20px;font-size:16px;
  line-height:2;height:8em;overflow:hidden}
.ticker .done{color:var(--ink)}
.ticker .todo{color:#C6C5BD}
.err{color:var(--ink-soft);font-size:13.5px}
</style>
