---
import HEAT from '../data/heat.json';
import { boardFromLabels, boardSize, KEY_UNIT, KEY_SIZE } from '../lib/keyboard.js';

const { id, geometry = 'row', title = '打鍵の偏り' } = Astro.props;
const d = HEAT[id];

/** 使用回数 0 のキーの色から、最も多いキーの色へ混ぜる */
const BASE = [0xF1, 0xF0, 0xEA];
const hex = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
const mix = (to, t) => '#' + BASE.map((b, i) =>
  Math.round(b + (to[i] - b) * t).toString(16).padStart(2, '0')).join('');

let keys = [], max = 0, legend = [];
if (d) {
  const to = hex(d.color);
  max = Math.max(...Object.values(d.heat), 1);
  keys = boardFromLabels(d.labels, d.subs, geometry, Object.keys(d.heat)).map(k => {
    const n = d.heat[k.id] ?? 0;
    // 平方根に近い曲線で、少ないキーも見えるようにする
    const t = n ? Math.pow(n / max, 0.6) : 0;
    return { ...k, n, fill: n ? mix(to, t) : '#FFFFFF', light: t > 0.62 };
  });
  legend = [0, 0.25, 0.5, 0.75, 1].map(t => ({
    fill: t ? mix(to, Math.pow(t, 0.6)) : '#FFFFFF',
    label: Math.round(max * t).toLocaleString('ja-JP'),
  }));
}
const size = keys.length ? boardSize(keys) : null;

const sum = d ? d.hands.L + d.hands.R + d.hands.thumb : 0;
const pct = n => sum ? Math.round(n / sum * 1000) / 10 : 0;
const nf = n => n.toLocaleString('ja-JP');
---
{d && (
  <section class="heat" style={`--gc:${d.color}`}>
    <h2 class="mincho">{title}</h2>
    <div class="src">
      お題文 全{nf(d.chars)}字を打ったときの、キーごとの打鍵回数です。
      濃いキーほど多く使います。同時押しに使うキーは、その回数分だけ数えています。
    </div>

    <figure>
      <svg viewBox={`0 0 ${size.w.toFixed(1)} ${size.h.toFixed(1)}`}
           xmlns="http://www.w3.org/2000/svg" role="img"
           aria-label={`${d.name}で全${nf(d.chars)}字を打ったときの打鍵回数`}>
        {keys.map(k => {
          const x = 1 + k.x * KEY_UNIT;
          const y = 1 + k.y * KEY_UNIT;
          const w = k.w * KEY_UNIT - (KEY_UNIT - KEY_SIZE);
          return (
            <g>
              <title>{`${k.l || k.id}　${nf(k.n)}回（${pct(k.n)}%）`}</title>
              <rect x={x.toFixed(1)} y={y.toFixed(1)} width={w.toFixed(1)} height={KEY_SIZE}
                    rx="2.5" fill={k.fill} stroke="#B4B3AB" />
              {k.l && (
                <text x={(x + w / 2).toFixed(1)} y={(y + KEY_SIZE / 2 + 4.4).toFixed(1)}
                      font-size={k.l.length > 1 ? 11 : 12.5} text-anchor="middle"
                      font-family="serif" fill={k.light ? '#FBFAF7' : '#23262A'}>{k.l}</text>
              )}
            </g>
          );
        })}
      </svg>

      <figcaption>
        <div class="key">
          <span>少ない</span>
          {legend.map(l => <i style={`background:${l.fill}`} title={`${l.label}回`}></i>)}
          <span>多い（最多 {nf(max)}回）</span>
        </div>
      </figcaption>
    </figure>

    <div class="hands">
      <div class="bar">
        <span class="l" style={`width:${pct(d.hands.L)}%`}></span>
        <span class="t" style={`width:${pct(d.hands.thumb)}%`}></span>
        <span class="r" style={`width:${pct(d.hands.R)}%`}></span>
      </div>
      <dl>
        <div><dt>左手</dt><dd>{pct(d.hands.L)}%<small>{nf(d.hands.L)}打</small></dd></div>
        {d.hands.thumb > 0 && (
          <div><dt>親指</dt><dd>{pct(d.hands.thumb)}%<small>{nf(d.hands.thumb)}打</small></dd></div>
        )}
        <div><dt>右手</dt><dd>{pct(d.hands.R)}%<small>{nf(d.hands.R)}打</small></dd></div>
        <div><dt>合計</dt><dd>{nf(d.total)}<small>打</small></dd></div>
      </dl>
    </div>
  </section>
)}

<style>
.heat{margin-bottom:44px}
.heat > h2{font-size:20px;font-weight:700;letter-spacing:.05em;
  border-bottom:2px solid var(--ink);padding-bottom:7px;margin-bottom:6px}
.heat .src{font-size:11.5px;color:var(--ink-soft);margin-bottom:18px;line-height:1.7}
figure{background:#fff;border:1px solid var(--rule);padding:20px 22px 14px}
figure svg{display:block;width:100%;height:auto}
figcaption{margin-top:12px;border-top:1px solid var(--paper-2);padding-top:10px}
.key{display:flex;align-items:center;gap:4px;font-size:11.5px;color:var(--ink-soft)}
.key i{display:block;width:26px;height:12px;border:1px solid var(--rule-strong)}
.key span:first-child{margin-right:4px}
.key span:last-child{margin-left:6px}

.hands{margin-top:18px}
.hands .bar{display:flex;height:12px;border:1px solid var(--rule-strong);overflow:hidden}
.hands .bar span{display:block;height:100%}
.hands .bar .l{background:var(--gc)}
.hands .bar .t{background:var(--chord)}
.hands .bar .r{background:var(--gc);opacity:.45}
.hands dl{display:flex;flex-wrap:wrap;gap:0 28px;margin-top:9px}
.hands dt{font-size:11.5px;color:var(--ink-soft)}
.hands dd{font-size:17px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.3}
.hands dd small{font-size:11.5px;font-weight:400;color:var(--ink-soft);margin-left:5px}
</style>
