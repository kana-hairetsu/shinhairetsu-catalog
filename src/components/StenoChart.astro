---
/**
 * 速記（メジロ式）の基本入力の早見表。
 * tools/<id>/chart.json を表にする。中身は本家エンジンで引いた結果で、手では書かない
 * （tools/mejiro/encoder の chart を実行すると作り直せる）。
 * 表の英字は Plover のストローク表記。左手・右手とも同じ並びで、左右対称。
 */
interface Props { data: any; color?: string; version?: string }
const { data, color = 'var(--gc)', version = '' } = Astro.props;
const fw = s => (s ?? '').replace(/\?/g, '？').replace(/!/g, '！');
const keys = k => k || '—';
---
<section class="steno-chart" style={`--kc:${color}`}>
  <h2 class="mincho">基本入力の早見表</h2>
  <div class="src">
    片手で1音節を打ちます。<b>子音キー（S・T・K・N）で行</b>を、<b>母音キー（Y・I・A・U）で段</b>を、
    <b>親指（n・t・k）で追加音</b>を選び、使うキーをすべて同時に押して、離したときに確定します。押す順番はありません。
    両手を同時に使うと、左手→右手の順に2音節が一度に出ます。英字はキーの名前（ストローク表記）で、
    <code>-</code> の左が左手、右が右手です。右手も左手と同じ並びです。
  </div>

  <ul class="ex">
    {data.example.map(e => <li><code>{e.keys}</code><span>{fw(e.out)}</span></li>)}
  </ul>

  <h3>子音×母音（片手で1音節）</h3>
  <div class="scroll">
    <table class="grid">
      <thead>
        <tr>
          <th class="corner">子音＼母音</th>
          {data.vowel.map(v => <th><code>{v.keys}</code><small>{v.name}</small></th>)}
        </tr>
      </thead>
      <tbody>
        {data.conso.map((c, i) => (
          <tr>
            <th><code>{keys(c.keys)}</code><small>{c.name}</small></th>
            {data.table[i].map(t => <td class:list={[{ long: [...t].length > 1 }]}>{t}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">N を足すと濁音になります（K→KN が か→が）。</p>

  <div class="pair">
    <div>
      <h3>母音キーの組み合わせ（二重母音）</h3>
      <table class="narrow">
        <thead><tr><th class="corner">母音</th><th class="corner">音</th><th class="corner">例（K）</th></tr></thead>
        <tbody>
          {data.diph.map(d => <tr><th><code>{d.keys}</code></th><td>{d.name}</td><td class="sm">{d.out}</td></tr>)}
        </tbody>
      </table>
    </div>
    <div>
      <h3>親指の追加音</h3>
      <table class="narrow">
        <thead><tr><th class="corner">親指</th><th class="corner">音</th><th class="corner">例（KA）</th></tr></thead>
        <tbody>
          {data.extra.map(d => <tr><th><code>{d.keys}</code></th><td>{d.name}</td><td class="sm">{d.out}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div>

  <div class="pair">
    <div>
      <h3>親指だけで押すと助詞</h3>
      <table class="narrow">
        <thead><tr><th class="corner">親指</th><th class="corner">左手</th><th class="corner">右手</th></tr></thead>
        <tbody>
          {data.particle_left.map((d, i) => (
            <tr><th><code>{d.keys}</code></th><td>{fw(d.out)}</td><td>{fw(data.particle_right[i].out)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div>
      <h3>「です」と「する」（右手）</h3>
      <table class="narrow">
        <thead><tr><th class="corner">入力</th><th class="corner">出力</th><th class="corner">入力</th><th class="corner">出力</th></tr></thead>
        <tbody>
          {data.desu.map((d, i) => (
            <tr><th><code>{d.keys}</code></th><td class="sm">{fw(d.out)}</td>
                <th><code>{data.verb[i].keys}</code></th><td class="sm">{fw(data.verb[i].out)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <p class="note">
    「です」「する」は左手の音節と一緒に押せます（<code>SIAU-TN</code> そうです）。
    <code>*</code> を使うと、ほかの動詞も同じ親指の組み合わせで活用できます。
    {version && `表は${version}のエンジンで引いた出力です。`}
  </p>
</section>

<style>
.steno-chart{margin-bottom:40px}
.steno-chart h2{font-size:20px;font-weight:700;letter-spacing:.05em;
  border-bottom:2px solid var(--ink);padding-bottom:7px;margin-bottom:6px}
.steno-chart .src{font-size:11.5px;color:var(--ink-soft);margin-bottom:14px;line-height:1.8}
.steno-chart .src b{color:var(--ink);font-weight:700}
.steno-chart h3{font-size:14px;font-weight:700;margin:24px 0 8px}
code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.92em;color:var(--kc);font-weight:700;letter-spacing:.02em}
.ex{list-style:none;display:flex;flex-wrap:wrap;gap:8px 10px;padding:0;margin:0 0 6px}
.ex li{background:#fff;border:1px solid var(--rule);padding:6px 12px;display:flex;gap:10px;align-items:baseline}
.ex span{font-family:"Shippori Mincho B1",serif;font-size:16px}
.scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;contain:inline-size}
table{border-collapse:collapse;background:#fff}
table.grid{width:100%;min-width:560px}
th,td{border:1px solid var(--rule);text-align:center;padding:5px 6px}
thead th{background:var(--paper-2);font-weight:400;font-size:13px;line-height:1.35}
tbody th{background:var(--paper-2);font-weight:400;font-size:13px;white-space:nowrap;text-align:left;line-height:1.35}
th small{display:block;font-size:10.5px;color:var(--ink-soft)}
tbody th small{display:inline;margin-left:6px}
td{font-family:"Shippori Mincho B1",serif;font-size:18px}
td.long{font-size:15px}
td.sm{font-size:15px;text-align:left;padding:5px 10px}
th.corner{font-size:11px;color:var(--ink-soft)}
.pair{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:0 24px}
table.narrow{width:100%}
.note{font-size:12px;color:var(--ink-soft);margin-top:10px;line-height:1.8}
@media (max-width:560px){
  table.grid{min-width:0}
  th,td{padding:4px 2px}
  td{font-size:15px}
  td.long{font-size:12px}
  thead th,tbody th{font-size:11px}
  tbody th small{display:block;margin:0}
}
</style>
