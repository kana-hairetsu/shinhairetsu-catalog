---
import '../styles/global.css';

/* 正式公開したら Cloudflare Pages の環境変数に PUBLIC_INDEXABLE=true を足す。
   既定は非公開モードで、検索エンジンに載らず、確認用の帯が出る。 */
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';

const { title, description = '日本語をより快適に打つための配列を集めたカタログです。', crumb = null } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!indexable && <meta name="robots" content="noindex, nofollow, noarchive" />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&family=Shippori+Mincho+B1:wght@500;700&display=swap" />
</head>
<body>
  {!indexable && (
    <div class="preflight">
      この版は<b>公開前の確認用</b>です。掲載内容は確定していません。URLの転載はお控えください。
    </div>
  )}

  <nav class="gnav">
    <div class="wrap">
      <a class="logo" href="/">新配列カタログ</a>
      {crumb && <div class="crumb" set:html={crumb} />}
    </div>
  </nav>

  <slot />

  <footer class="gfoot">
    <div class="wrap">
      掲載内容は、各配列の作者ご本人（または了承を得た代理の方）による自己申告です。
      主催側による評価づけは行っていません。
      訂正・掲載取り下げ等のご要望、ご連絡は、Xの <a href="https://x.com/kanahairetsu" rel="me">@kanahairetsu</a> までお願いします。
    </div>
  </footer>
</body>
</html>

<style is:global>
.preflight{background:#7A5C2E;color:#FBFAF7;font-size:12.5px;padding:9px 24px;text-align:center}
.preflight b{font-weight:700}
</style>
